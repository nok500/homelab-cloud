<?xml version="1.0"?>
<!--
  Generated by terraform/host (templates/opnsense-config.xml.tftpl). Imported once on first boot
  by scripts/opnsense-console-import.py. Based on OPNsense ${opnsense_version} src/etc/config.xml.sample.
  vtnet order = libvirt interface order: vtnet0 WAN (macvtap), vtnet1 private, vtnet2 public, vtnet3 data.
-->
<opnsense>
  <theme>opnsense</theme>
  <system>
    <optimization>normal</optimization>
    <hostname>${hostname}</hostname>
    <domain>${domain}</domain>
    <dnsallowoverride>1</dnsallowoverride>
    <dnsallowoverride_exclude/>
    <group>
      <name>admins</name>
      <description>System Administrators</description>
      <scope>system</scope>
      <gid>1999</gid>
      <member>0</member>
      <priv>page-all</priv>
    </group>
    <user>
      <name>root</name>
      <descr>System Administrator</descr>
      <scope>system</scope>
      <groupname>admins</groupname>
      <password>${root_password_hash}</password>
      <authorizedkeys>${root_authorized_keys_b64}</authorizedkeys>
      <uid>0</uid>
    </user>
    <timezone>${timezone}</timezone>
    <timeservers>${ntp_server}</timeservers>
    <webgui>
      <protocol>https</protocol>
    </webgui>
    <disablenatreflection>yes</disablenatreflection>
    <!-- nano image runs headless: login/console menu on the serial port (virsh console) -->
    <primaryconsole>serial</primaryconsole>
    <serialspeed>115200</serialspeed>
    <usevirtualterminal>1</usevirtualterminal>
    <disableconsolemenu/>
    <powerd_ac_mode>hadp</powerd_ac_mode>
    <powerd_battery_mode>hadp</powerd_battery_mode>
    <powerd_normal_mode>hadp</powerd_normal_mode>
    <bogons>
      <interval>monthly</interval>
    </bogons>
    <pf_share_forward>1</pf_share_forward>
    <lb_use_sticky>1</lb_use_sticky>
    <ssh>
      <group>admins</group>
      <enabled>enabled</enabled>
      <permitrootlogin>1</permitrootlogin>
    </ssh>
  </system>
  <interfaces>
    <wan>
      <enable>1</enable>
      <if>vtnet0</if>
      <descr>WAN</descr>
      <spoofmac/>
      <ipaddr>dhcp</ipaddr>
      <!-- the "internet" side is the home LAN (RFC1918), so private-network blocking must be off -->
      <blockbogons>1</blockbogons>
      <dhcphostname>${hostname}</dhcphostname>
    </wan>
%{ for s in subnets ~}
    <${s.ifkey}>
      <enable>1</enable>
      <if>${s.ifname}</if>
      <descr>${upper(s.name)}</descr>
      <spoofmac/>
      <ipaddr>${s.gateway}</ipaddr>
      <subnet>${s.prefix}</subnet>
    </${s.ifkey}>
%{ endfor ~}
  </interfaces>
  <dnsmasq>
    <enable>1</enable>
    <port>53053</port>
    <interface>${join(",", [for s in subnets : s.ifkey])}</interface>
    <dhcp>
      <domain>${domain}</domain>
    </dhcp>
%{ for s in subnets ~}
    <dhcp_ranges>
      <interface>${s.ifkey}</interface>
      <start_addr>${s.dhcp_start}</start_addr>
      <end_addr>${s.dhcp_end}</end_addr>
    </dhcp_ranges>
%{ endfor ~}
%{ for h in static_hosts ~}
    <hosts>
      <host>${h.name}</host>
      <domain>${domain}</domain>
      <ip>${h.ip}</ip>
      <hwaddr>${h.mac}</hwaddr>
      <descr>${h.descr}</descr>
    </hosts>
%{ endfor ~}
  </dnsmasq>
  <unbound>
    <enable>1</enable>
  </unbound>
  <nat>
    <outbound>
      <mode>automatic</mode>
    </outbound>
  </nat>
  <filter>
  </filter>
  <rrd>
    <enable/>
  </rrd>
  <!-- one upstream pool; served to the VPC subnets (Talos nodes use 10.10.x.1), like AWS Time Sync -->
  <ntpd>
    <prefer>${ntp_server}</prefer>
    <ispool>${ntp_server}</ispool>
    <interface>${join(",", [for s in subnets : s.ifkey])}</interface>
  </ntpd>
  <OPNsense>
    <!-- Unbound: lab.macpro (DHCP names) from dnsmasq, everything else forwarded upstream (AdGuard).
         Written in the legacy <domains> (Domain Overrides) format on purpose: model migration M1_0_11
         converts these into <dots> entries of type "forward". Entries written directly as <dots> come
         out as type "dot" (DNS-over-TLS) after the migrations run, which breaks plain-DNS forwarding.
         No version= attribute, so all migrations run and fill in the model defaults. -->
    <unboundplus>
      <general>
        <enabled>1</enabled>
      </general>
      <domains>
        <domain>
          <enabled>1</enabled>
          <domain>${domain}</domain>
          <server>127.0.0.1@53053</server>
          <description>DHCP host names (dnsmasq)</description>
        </domain>
%{ if upstream_dns != null ~}
        <domain>
          <enabled>1</enabled>
          <domain/>
          <server>${upstream_dns}@53</server>
          <description>upstream resolver (all other names)</description>
        </domain>
%{ endif ~}
      </domains>
    </unboundplus>
    <Firewall>
      <Filter>
        <rules>
%{ for r in rules ~}
          <rule>
            <enabled>1</enabled>
            <statetype>keep</statetype>
            <state-policy/>
            <sequence>${r.sequence}</sequence>
            <action>pass</action>
            <quick>1</quick>
            <interfacenot>0</interfacenot>
            <interface>${r.interface}</interface>
            <direction>in</direction>
            <ipprotocol>inet</ipprotocol>
            <protocol>${r.protocol}</protocol>
            <source_net>${r.source}</source_net>
            <source_not>0</source_not>
            <source_port/>
            <destination_net>${r.destination}</destination_net>
            <destination_not>0</destination_not>
            <destination_port>${r.port}</destination_port>
            <disablereplyto>${r.replyto ? 0 : 1}</disablereplyto>
            <log>${r.log ? 1 : 0}</log>
            <allowopts>0</allowopts>
            <nosync>0</nosync>
            <nopfsync>0</nopfsync>
            <statetimeout/>
            <tcpflags_any>0</tcpflags_any>
            <description>${r.description}</description>
          </rule>
%{ endfor ~}
        </rules>
        <snatrules/>
        <npt/>
        <onetoone/>
      </Filter>
    </Firewall>
  </OPNsense>
</opnsense>
